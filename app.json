{
  "expo": {
    "name": "Estante",
    "slug": "estante",
    "scheme": "estante",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5ECD9",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.estante.leitura",
      "adaptiveIcon": {
        "backgroundColor": "#F5ECD9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-image",
      "expo-font",
      "expo-system-ui",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada para ler o código de barras (ISBN) e fotografar lombadas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "As fotos são usadas para capas e lombadas dos livros.",
          "cameraPermission": "A câmera é usada para fotografar capas e lombadas."
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5ef68664-8f80-45eb-8a29-f74025e23d40"
      }
    },
    "owner": "joaomaggi"
  }
}
